# Local setup values for Fabric MCP + Copilot Studio
# Copy this file to .env before running notebooks.
# Values are read and updated by setup notebooks.

# ======================================================================
# Shared Values
# ======================================================================
TENANT_ID=
SUBSCRIPTION_ID=
SUBSCRIPTION_NAME=
SIGNED_IN_USER=

# ======================================================================
# Output Configuration
# ======================================================================
# Folder where generated Swagger specs are saved (defaults to c:\temp)
OUTPUT_FOLDER=c:\temp

# ======================================================================
# Connector App Registration (Client)
# ======================================================================
APP_DISPLAY_NAME=Copilot Studio - Fabric MCP Connector
CONNECTOR_APP_DISPLAY_NAME=Copilot Studio - Fabric MCP Connector OBO
CONNECTOR_APP_DISPLAY_NAME_NEW=Copilot Studio - Fabric MCP Connector OBO
EXISTING_CONNECTOR_APP_ID=
CONNECTOR_CLIENT_ID=
CONNECTOR_APP_ID_URI=
REDIRECT_URIS=
CLIENT_ID=
OBJECT_ID=
CLIENT_SECRET_EXPIRES_ON=
SECRET_DISPLAY_NAME=copilot-studio-mcp

# ======================================================================
# Service App Registration (Resource)
# ======================================================================
SERVICE_APP_DISPLAY_NAME=Fabric Data Agent Service
SERVICE_APP_ID=
SERVICE_CLIENT_ID=
SERVICE_APP_OBJECT_ID=
SERVICE_APP_ID_URI=
