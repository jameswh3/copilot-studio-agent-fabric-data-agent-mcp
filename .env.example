# Local setup values for Fabric MCP + Copilot Studio OBO
# Copy this file to .env and fill in your values before running the notebook.

# ======================================================================
# Required Values
# ======================================================================

# Your Microsoft Entra tenant ID
TENANT_ID=<your-tenant-id>

# Service app registration (resource app) client ID
SERVICE_APP_ID=<service-app-client-id>

# Connector app registration (client app) client ID
CONNECTOR_CLIENT_ID=<connector-app-client-id>

# Fabric Data Agent MCP endpoint URL
MCP_SERVER_URL=https://api.fabric.microsoft.com/v1/mcp/workspaces/<workspace-id>/dataagents/<dataagent-id>/agent

# ======================================================================
# Optional Values
# ======================================================================

# Azure API Connections service principal ID (defaults to fe053c5f-3692-4f14-aef2-ee34fc081cae)
# Only change this if your tenant has a custom API Connections SP
AZURE_API_CONNECTIONS_SP_ID=fe053c5f-3692-4f14-aef2-ee34fc081cae

# Output file name for generated Swagger spec (defaults to workingswagger-obo-template.yaml)
SWAGGER_OUTPUT_FILE=workingswagger-obo-template.yaml
FIC_AUDIENCE=api://AzureADTokenExchange
FIC_ISSUER=
FIC_SUBJECT=

# ======================================================================
# Fabric Discovery and MCP Endpoint
# ======================================================================
WORKSPACE_IDS=
AGENT_NAMES_FILTER=
MCP_WORKSPACE_NAME=
MCP_AGENT_NAME=
MCP_ENDPOINT_URL=
